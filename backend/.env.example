# --- Base de datos ---
DATABASE_URL=sqlite:///./ti_diagnostic.db

# --- Agentes (auth machine-to-machine). Vacío = auth de agentes desactivada (local). ---
API_KEY=

# --- CORS ---
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Seed / logging ---
ALLOW_SEED_DATA=true
LOG_LEVEL=INFO

# --- Autenticación del panel (JWT) ---
# IMPORTANTE: cambia JWT_SECRET en producción por un valor largo y aleatorio.
JWT_SECRET=cambia-esta-clave-secreta-en-produccion
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Usuario admin que se crea automáticamente si no hay usuarios.
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=admin123

# --- Retención de snapshots de métricas (días) ---
SNAPSHOT_RETENTION_DAYS=30
